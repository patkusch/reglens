# Copy to .env and fill in. `source .env` before running.

# --- DataHub (local quickstart) ---
export DATAHUB_GMS_URL="http://localhost:8080"
# Create a Personal Access Token in the DataHub UI:
#   http://localhost:9002  ->  Settings  ->  Access Tokens  ->  Generate
export DATAHUB_TOKEN=""

# The MCP server reads these too (uvx mcp-server-datahub):
export DATAHUB_GMS_TOKEN="${DATAHUB_TOKEN}"

# --- MCP server ---
# RegLens needs the write-back (mutation) tools switched ON.
export TOOLS_IS_MUTATION_ENABLED="true"
# Override how the MCP server is launched if needed:
# export MCP_COMMAND="uvx"
# export MCP_ARGS="mcp-server-datahub"

# The platform label the fictional bank is seeded under (any string is fine):
export BANK_PLATFORM="snowflake"

# --- Optional LLM driver ---
# export ANTHROPIC_API_KEY="sk-ant-..."
